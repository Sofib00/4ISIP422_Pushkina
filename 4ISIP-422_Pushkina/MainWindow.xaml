<Window x:Class="_4ISIP_422_Pushkina.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_4ISIP_422_Pushkina"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="ProductsList" Grid.Row="0" FontSize="14" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Добавить" Width="120" Margin="5" Click="AddProduct_Click"/>
            <Button Content="Удалить" Width="120" Margin="5" Click="DeleteProduct_Click"/>
            <Button Content="Поставка" Width="120" Margin="5" Click="RestockProduct_Click"/>
            <Button Content="Продать" Width="120" Margin="5" Click="SellProduct_Click"/>
            <Button Content="Поиск" Width="120" Margin="5" Click="SearchProduct_Click"/>
        </StackPanel>
    </Grid>
</Window>